# Copy to .env and fill in local or Neon values. Never commit .env.

# Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Set true for Neon (and most hosted Postgres). Local Postgres can stay false.
DATABASE_SSL_REQUIRE=true

HR_EMAIL=hr.manager@esmincubyte.example
HR_PASSWORD=ChangeMeNow!

# Comma-separated Origins allowed on cookie-authenticated mutations.
# Include the Vite dev origin, local API origin, TestClient, and the FastAPI Cloud URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://testserver,https://incubyteesm.fastapicloud.dev

# development | production  (production cookies are Secure)
ENVIRONMENT=development

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_HOURS=4
